call Keyboard.keyPressed 0
push constant 71 // G
eq
not
if-goto scipgreen
push constant 0
push constant 255
push constant 0
call Screen.setColorRGB 3
pop temp 0
label scipgreen

call Keyboard.keyPressed 0
push constant 66 // B
eq
not
if-goto scipblue
push constant 0
push constant 0
push constant 255
call Screen.setColorRGB 3
pop temp 0
label scipblue

call Keyboard.keyPressed 0
push constant 67 // C
eq
not
if-goto scipcircle
push constant 100
push constant 100
push constant 25
call Screen.drawCircle 3
pop temp 0
label scipcircle

call Keyboard.keyPressed 0
push constant 76 // L
eq
not
if-goto scipline
push constant 300
push constant 150
push constant 200
push constant 50
