call Keyboard.keyPressed 0
push constant 49 // 1
eq
not
if-goto scipblack
push constant 1
call Screen.setColor 1
pop temp 0
label scipblack

call Keyboard.keyPressed 0
push constant 82 // R
eq
not
if-goto scipred
push constant 255
